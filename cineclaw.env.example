# ==============================================================================
# CineClaw — Minimal Silent Setup Configuration (cineclaw.env)
# ==============================================================================

# Required for posters, seasons, trailers, and rich metadata
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Host IP or Domain used for streaming to external TVs & devices
# (If omitted or commented out, the installer auto-detects your local LAN IP)
# NAS_IP=192.168.1.50

# Optional: Persistent storage directory path (defaults to ./data)
# On Synology: /volume1/docker/cineclaw/data
# On TrueNAS:  /mnt/tank/cineclaw
# DATA_DIR=./data

# Optional: Timezone (defaults to Europe/Moscow)
# TZ=Europe/Moscow

# Optional: Private tracker accounts (RuTor works without credentials)
# RUTRACKER_USERNAME=
# RUTRACKER_PASSWORD=
# NNMCLUB_USERNAME=
# NNMCLUB_PASSWORD=

# Web UI & API Authentication (defaults: admin / wavemp3)
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=wavemp3

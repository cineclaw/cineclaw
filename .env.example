# ==============================================================================
# CineClaw: Environment Configuration
# ==============================================================================

# Docker image version tag (latest, 1.0.0, 1.0, etc.)
IMAGE_TAG=latest

# Root directory for all persistent data (database, media, torrent stubs, caches)
# On a NAS, you can change this to your shared volume (e.g. /volume1/media or /mnt/tank/cineclaw)
DATA_DIR=./data

# NAS IP address or domain name (used for client redirects and webhooks)
NAS_IP=127.0.0.1

# Time zone for log timestamps and container scheduling
TZ=Europe/Moscow

# ------------------------------------------------------------------------------
# Metadata & Tracker Credentials
# ------------------------------------------------------------------------------

# TMDB API Key (v3 32-character key or v4 Bearer token)
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RuTracker credentials (optional, for private search / torrent downloads)
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=

# NNM-Club credentials (optional, for private search / torrent downloads)
NNMCLUB_USERNAME=
NNMCLUB_PASSWORD=

# Jellyfin API Key (pre-generated or configured in Jellyfin Dashboard -> API Keys)
JELLYFIN_API_KEY=a4151fee9ef64ea6b23b185f8fe2720e

# ------------------------------------------------------------------------------
# Port Customization (change if any port conflicts with existing NAS services)
# ------------------------------------------------------------------------------
PORT_FRONTEND=3000
PORT_JELLYFIN=8096
PORT_INDEXER=8090
PORT_PROXY=9118
PORT_TIRAMISU=9080
PORT_FLARESOLVERR=8191
PORT_LODESTARR=3420
